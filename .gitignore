# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/e2e/mock/.cache

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
CODE_ISSUES_FOR_LLM.md

# Keep current guides in Git; historical analysis and captured pages stay local.
/docs/*
!/docs/README.md
!/docs/recording-and-sync.md
!/docs/testing.md

# claude code local files
/.claude
CLAUDE.md
